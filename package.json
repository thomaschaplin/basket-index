{
  "name": "basket-index",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Cost-of-living insights from your own Tesco and Sainsbury's receipts. Parsed in the browser, never uploaded.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "sample": "vite-node scripts/generate-sample.ts",
    "og": "node scripts/render-og.mjs",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "fflate": "^0.8.2",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.469.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "fake-indexeddb": "6.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8",
    "vite": "^6.4.4",
    "vitest": "^5.0.5"
  }
}
