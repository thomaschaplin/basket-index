{
  "name": "basket-index",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Cost-of-living insights from your own Tesco and Sainsbury's receipts. Parsed in the browser, never uploaded.",
  "license": "MIT",
  "author": "Thomas Chaplin",
  "homepage": "https://basketindex.thomaschaplin.me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomaschaplin/basket-index.git"
  },
  "bugs": {
    "url": "https://github.com/thomaschaplin/basket-index/issues"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "sample": "node scripts/generate-sample.ts",
    "og": "node scripts/render-og.mjs",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "fflate": "^0.8.3",
    "framer-motion": "^14.12.0",
    "lucide-react": "^1.71.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "6.2.8",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
